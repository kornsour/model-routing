{
  "id": 21612230,
  "name": "Required checks: TypeScript apps (by property)",
  "target": "branch",
  "source_type": "Organization",
  "source": "Copperline",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    },
    "repository_property": {
      "include": [
        {
          "name": "stack",
          "property_values": [
            "typescript"
          ]
        },
        {
          "name": "ci-managed",
          "property_values": [
            "true"
          ]
        }
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "ci / Build"
          },
          {
            "context": "ci / Lint & format (Biome)"
          },
          {
            "context": "ci / Type check"
          },
          {
            "context": "ci / Unit tests (Vitest)"
          },
          {
            "context": "lockfile / integrity"
          }
        ]
      }
    }
  ]
}
