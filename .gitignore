# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.pyright/
dist/
build/

# Native / compiled extensions
*.so

# Environments & secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
