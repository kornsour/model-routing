# index.sqlite and dashboard.html are regenerated by `make dashboard`

# Local-only Claude Code state (worktrees hold full checkouts + their results/)
.claude/worktrees/
.claude/settings.local.json

# Personal data harvested from local transcripts (also in tasks/agentic/.gitignore)
tasks/agentic/private/

# Local databases, snapshots and exported run bundles - may contain model outputs
*.sqlite
*.sqlite-journal
*.sqlite-wal
/exports/
